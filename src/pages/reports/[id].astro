---
// 分析报告全文页：src/content/reports/ 里每个 md 生成一页，改 md 就能更新
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((r) => ({ params: { id: r.id }, props: { report: r } }));
}

const { report } = Astro.props;
const { Content, headings } = await render(report);
// 标题取 md 第一行的 # 标题
const title = headings.find((h) => h.depth === 1)?.text ?? report.id;
// 目录：二级和三级标题
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
// 返回到「洞察与分析项目」里对应的小卡片（顺序和 analysis.md 一致）
const tabOf: Record<string, number> = { olist: 0, game: 1, watsons: 2 };
const back = `/demo?tab=${tabOf[report.id] ?? 0}#analysis`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f1ec" />
    <title>{title} · 韩昕汐</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="font-sans">
    <!-- 顶部：返回 + 标题 -->
    <header class="topbar">
      <a href={back} class="back">← 返回</a>
      <p class="top-title">{title}</p>
    </header>

    <div class="layout">
      <!-- 目录：电脑左侧固定；手机在顶部，可展开 -->
      {
        toc.length > 0 && (
          <nav class="toc" aria-label="目录">
            <details class="toc-box" data-toc>
              <summary>目录</summary>
              <ol>
                {toc.map((h) => (
                  <li class:list={[h.depth === 3 && 'sub']}>
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }

      <article class="prose">
        <Content />
      </article>
    </div>

    <!-- 点击图片放大 -->
    <div class="zoom" data-zoom hidden>
      <img alt="" />
    </div>

    <script>
      // 电脑上目录默认展开；手机上默认折叠，点了目录项后收起
      const box = document.querySelector<HTMLDetailsElement>('[data-toc]');
      const wide = matchMedia('(min-width: 1024px)');
      const syncToc = () => box && (box.open = wide.matches);
      syncToc();
      wide.addEventListener('change', syncToc);
      box?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a') && !wide.matches) box.open = false;
      });

      // 读到哪一节，目录里就高亮哪一节
      const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
      const heads = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')];
      const spy = () => {
        let cur = heads[0];
        for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.3) cur = h;
        links.forEach((a) => a.classList.remove('is-on'));
        const on = cur && links.get(cur.id);
        if (on) {
          on.classList.add('is-on');
          if (wide.matches) on.scrollIntoView({ block: 'nearest' });
        }
      };
      addEventListener('scroll', spy, { passive: true });
      spy();

      // 图片点击放大
      const zoom = document.querySelector<HTMLElement>('[data-zoom]')!;
      const zoomImg = zoom.querySelector('img')!;
      document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) =>
        img.addEventListener('click', () => {
          zoomImg.src = img.currentSrc || img.src;
          zoomImg.alt = img.alt;
          zoom.hidden = false;
        }),
      );
      zoom.addEventListener('click', () => (zoom.hidden = true));
      addEventListener('keydown', (e) => e.key === 'Escape' && (zoom.hidden = true));

      // 表格放进可横向滑动的容器，手机上不撑破页面
      document.querySelectorAll('.prose table').forEach((t) => {
        const wrap = document.createElement('div');
        wrap.className = 'table-wrap';
        t.replaceWith(wrap);
        wrap.append(t);
      });
    </script>

    <style>
      @reference '../../styles/global.css';

      :root {
        --accent: #2e3a4f;
        --ink: #2b2823;
        --paper: #f3f1ec;
        --line: rgb(43 40 35 / 0.12);
      }
      body {
        background: var(--paper);
        color: var(--ink);
      }
      html {
        scroll-padding-top: 5rem;
      }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        padding: 0.9rem 1rem;
        background: color-mix(in oklab, var(--paper) 92%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      @media (min-width: 640px) {
        .topbar {
          padding: 1rem 1.5rem;
        }
      }
      .back {
        flex-shrink: 0;
        font-size: 0.875rem;
        color: var(--accent);
      }
      .back:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      .top-title {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.8125rem;
        opacity: 0.6;
      }

      .layout {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1rem 6rem;
      }
      @media (min-width: 1024px) {
        .layout {
          display: grid;
          grid-template-columns: 240px minmax(0, 1fr);
          gap: 4rem;
          padding: 0 2rem 8rem;
        }
      }

      /* 目录 */
      .toc {
        position: sticky;
        top: 3.4rem;
        z-index: 10;
        margin: 0 -1rem;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
      }
      .toc summary {
        cursor: pointer;
        padding: 0.75rem 1rem;
        font-size: 0.8125rem;
        letter-spacing: 0.2em;
        color: var(--accent);
      }
      .toc ol {
        max-height: 60svh;
        overflow-y: auto;
        padding: 0 1rem 1rem;
      }
      .toc li {
        font-size: 0.8125rem;
        line-height: 1.5;
      }
      .toc li.sub {
        padding-left: 0.9rem;
        font-size: 0.75rem;
      }
      .toc a {
        display: block;
        padding: 0.3rem 0 0.3rem 0.75rem;
        border-left: 2px solid transparent;
        opacity: 0.6;
        transition: opacity 0.2s ease;
      }
      .toc a:hover {
        opacity: 1;
      }
      .toc a.is-on {
        opacity: 1;
        color: var(--accent);
        font-weight: 600;
        border-color: var(--accent);
      }
      @media (min-width: 1024px) {
        .toc {
          top: 4.5rem;
          align-self: start;
          margin: 2.5rem 0 0;
          border: 0;
          background: none;
        }
        .toc summary {
          padding: 0 0 0.75rem;
          pointer-events: none;
          list-style: none;
        }
        .toc summary::-webkit-details-marker {
          display: none;
        }
        .toc ol {
          max-height: calc(100svh - 8rem);
          padding: 0 0.5rem 0 0;
          scrollbar-width: thin;
        }
      }

      /* 正文：适合长时间阅读 */
      .prose {
        max-width: 720px;
        padding-top: 2rem;
        font-size: 16px;
        line-height: 1.9;
      }
      @media (min-width: 640px) {
        .prose {
          font-size: 17px;
          padding-top: 3rem;
        }
      }
      .prose :global(h1) {
        font-size: 1.75rem;
        line-height: 1.35;
        font-weight: 600;
        color: var(--accent);
      }
      @media (min-width: 640px) {
        .prose :global(h1) {
          font-size: 2.1rem;
        }
      }
      .prose :global(h2) {
        margin-top: 3.2rem;
        padding-top: 1.2rem;
        border-top: 1px solid var(--line);
        font-size: 1.4rem;
        line-height: 1.4;
        font-weight: 600;
        color: var(--accent);
      }
      /* md 里 --- 后面紧跟标题时，不再画第二条线 */
      .prose :global(hr + h2) {
        margin-top: 0;
        padding-top: 0;
        border-top: 0;
      }
      .prose :global(h3) {
        margin-top: 2.2rem;
        font-size: 1.12rem;
        font-weight: 600;
        color: var(--accent);
      }
      .prose :global(h4) {
        margin-top: 1.6rem;
        font-weight: 600;
      }
      .prose :global(p),
      .prose :global(ul),
      .prose :global(ol),
      .prose :global(pre),
      .prose :global(blockquote) {
        margin-top: 1rem;
      }
      .prose :global(ul) {
        list-style: disc;
        padding-left: 1.4em;
      }
      .prose :global(ol) {
        list-style: decimal;
        padding-left: 1.6em;
      }
      .prose :global(li + li) {
        margin-top: 0.35rem;
      }
      .prose :global(strong) {
        font-weight: 650;
        color: #1b1915;
      }
      .prose :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
        text-underline-offset: 3px;
        word-break: break-all;
      }
      .prose :global(blockquote) {
        padding: 0.9rem 1.2rem;
        border-left: 3px solid var(--accent);
        background: color-mix(in oklab, var(--accent) 6%, #fff);
        border-radius: 0 4px 4px 0;
        font-size: 0.94em;
      }
      .prose :global(blockquote p:first-child) {
        margin-top: 0;
      }
      .prose :global(hr) {
        margin: 2.5rem 0;
        border: 0;
        border-top: 1px solid var(--line);
      }
      .prose :global(code) {
        padding: 0.1em 0.35em;
        border-radius: 3px;
        background: rgb(43 40 35 / 0.07);
        font-size: 0.86em;
        word-break: break-word;
      }
      .prose :global(pre) {
        padding: 1rem;
        overflow-x: auto;
        border-radius: 4px;
        background: rgb(43 40 35 / 0.06) !important;
        font-size: 0.85em;
        line-height: 1.6;
      }
      .prose :global(pre code) {
        padding: 0;
        background: none;
      }
      .prose :global(img) {
        display: block;
        width: 100%;
        height: auto;
        margin: 1.5rem 0 0.5rem;
        border-radius: 4px;
        background: #fff;
        cursor: zoom-in;
      }
      /* 表格：细线、表头底色；放不下时在表格内横向滑动 */
      .prose :global(.table-wrap) {
        margin-top: 1.25rem;
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: 4px;
        background: #fff;
      }
      .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.86em;
        line-height: 1.6;
      }
      .prose :global(th),
      .prose :global(td) {
        padding: 0.55rem 0.8rem;
        border-bottom: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
        min-width: 5.5em;
      }
      .prose :global(th) {
        background: color-mix(in oklab, var(--accent) 8%, #fff);
        font-weight: 600;
        white-space: nowrap;
      }
      .prose :global(tr:last-child td) {
        border-bottom: 0;
      }

      .zoom {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-items: center;
        padding: 1rem;
        background: rgb(20 18 15 / 0.85);
        cursor: zoom-out;
      }
      .zoom[hidden] {
        display: none;
      }
      .zoom img {
        max-width: 100%;
        max-height: 100%;
        border-radius: 4px;
        background: #fff;
      }
    </style>
  </body>
</html>
