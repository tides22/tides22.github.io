---
import '../styles/global.css';
import { isTodo } from '../lib/todo';

interface Props {
  title: string;
  description: string;
  name: string;
  email: string;
  resume: string;
}

const { title, description, name, email, resume } = Astro.props;
const hasResume = !isTodo(resume);
const nav = [
  { label: '项目', href: '#projects' },
  { label: '经历', href: '#experience' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7fcfa" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/smiley-sans.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <nav class="border-line/70 bg-paper/80 sticky top-0 z-50 border-b backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
        <a href="#top" class="font-display text-xl tracking-wide">{name}</a>
        <div class="flex items-center gap-4 text-[15px] sm:gap-6">
          {
            nav.map((item) => (
              <a href={item.href} class="text-muted hover:text-leaf-deep transition-colors">
                {item.label}
              </a>
            ))
          }
          {
            hasResume ? (
              <a href={resume} download class="bg-ink text-paper rounded-full px-3.5 py-1 text-sm">
                简历
              </a>
            ) : (
              <span
                title={resume}
                class="border-sun bg-sun-soft rounded-full border border-dashed px-3 py-1 text-sm"
              >
                简历
              </span>
            )
          }
        </div>
      </div>
    </nav>

    <slot />

    <footer class="border-line mt-8 border-t">
      <div
        class="text-muted mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>
          联系我：<a href={`mailto:${email}`} class="text-sea-deep underline-offset-4 hover:underline">{email}</a>
        </p>
        <p>© {new Date().getFullYear()} {name}</p>
      </div>
    </footer>

    <script>
      // 滚动到可视区域时浮现
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // 一键复制邮箱
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        const label = button.querySelector('[data-copy-label]');
        const original = label?.textContent;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            if (label) label.textContent = '已复制 ✓';
          } catch {
            window.location.href = `mailto:${button.dataset.copy}`;
            return;
          }
          setTimeout(() => {
            if (label) label.textContent = original ?? '';
          }, 2000);
        });
      });
    </script>
  </body>
</html>
