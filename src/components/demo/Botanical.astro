---
// 细线植物插画：从卡片右下角沿边框生长。线条可做「生长」描线动画。
// 画布 200×320，植物根部在底边。
interface Props {
  kind: 'me' | 'cidi' | 'venture' | 'analysis' | 'intern';
  class?: string;
  style?: string;
}

const { kind, class: className, style } = Astro.props;

const LEAF = '#a8c3a0';
let order = 0;
// 每条线按出现顺序带一个延迟，形成从根部往上长的效果
const delay = () => `--d:${Math.min(order++ * 0.035, 1.4).toFixed(2)}s`;
// 稳定的伪随机，保证每次构建图案一致
let seed = kind.length * 97;
const rand = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

const line = (d: string, width = 1, color = 'currentColor') =>
  `<path d="${d}" pathLength="1" class="ln" stroke="${color}" stroke-width="${width}" style="${delay()}"/>`;
const shape = (d: string, fill: string, opacity: number, stroke = 'currentColor', extra = '') =>
  `<path d="${d}" pathLength="1" class="ln pt" stroke="${stroke}" style="--f:${fill};--o:${opacity};${delay()}" ${extra}/>`;
const dot = (x: number, y: number, r: number, fill: string, o = 0.7) =>
  `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r}" class="dot" fill="${fill}" style="--o:${o};${delay()}"/>`;

// 叶子：带主脉和侧脉
const leaf = (x: number, y: number, angle: number, len: number, w: number) => {
  const body = `M0 0 C${w} ${-len * 0.25} ${w * 0.85} ${-len * 0.72} 0 ${-len} C${-w * 0.85} ${-len * 0.72} ${-w} ${-len * 0.25} 0 0Z`;
  const rib = `M0 0 C${w * 0.08} ${-len * 0.4} ${w * 0.05} ${-len * 0.7} 0 ${-len * 0.96}`;
  const veins = [0.3, 0.5, 0.7]
    .map((t) => `M0 ${-len * t} L${w * 0.55} ${-len * (t + 0.12)} M0 ${-len * t} L${-w * 0.55} ${-len * (t + 0.12)}`)
    .join(' ');
  return `<g transform="translate(${x} ${y}) rotate(${angle})">${shape(body, LEAF, 0.22, LEAF)}${line(rib, 0.7, LEAF)}${line(veins, 0.5, LEAF)}</g>`;
};

// 卷须：缠绕的螺旋
const tendril = (x: number, y: number, r0: number, turns: number, dir = 1) => {
  const pts: string[] = [];
  const steps = 40;
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const a = dir * t * turns * Math.PI * 2;
    const r = r0 * (1 - t * 0.85);
    pts.push(`${(x + Math.cos(a) * r - r0).toFixed(1)} ${(y + Math.sin(a) * r).toFixed(1)}`);
  }
  return line(`M${pts.join(' L')}`, 0.7, LEAF);
};

// 雏菊
const daisy = (cx: number, cy: number, r: number, tilt: number, rot = 0) => {
  const n = 18;
  let petals = '';
  for (let i = 0; i < n; i++) {
    const L = r * (0.82 + rand() * 0.18);
    const a = (360 / n) * i + rand() * 6;
    petals += `<g transform="rotate(${a.toFixed(1)})">${shape(
      `M0 -3 C-2.6 ${-L * 0.4} -2.2 ${-L * 0.9} 0 ${-L} C2.2 ${-L * 0.9} 2.6 ${-L * 0.4} 0 -3Z`,
      '#f4f1e6',
      0.5,
    )}</g>`;
  }
  let center = '';
  for (let i = 0; i < 16; i++) {
    const rr = 1.3 * Math.sqrt(i);
    const a = i * 2.4;
    center += dot(Math.cos(a) * rr, Math.sin(a) * rr, 0.6, '#8a6a3c', 0.8);
  }
  return `<g transform="translate(${cx} ${cy}) rotate(${rot}) scale(1 ${tilt})">${petals}<circle r="${(r * 0.24).toFixed(1)}" fill="#e2b84f" class="dot" style="--o:.9;${delay()}"/>${center}</g>`;
};

// 白玉兰：杯状的三片外瓣
const magnolia = (x: number, y: number, rot: number, s: number) =>
  `<g transform="translate(${x} ${y}) rotate(${rot}) scale(${s})">
    ${shape('M0 0 C-14 -4 -25 -22 -21 -40 C-10 -31 -3 -16 0 0Z', '#e8c5c8', 0.35)}
    ${shape('M0 0 C14 -4 25 -22 21 -40 C10 -31 3 -16 0 0Z', '#e8c5c8', 0.35)}
    ${shape('M0 0 C-11 -9 -12 -32 0 -48 C12 -32 11 -9 0 0Z', '#f7f3ee', 0.55)}
    ${line('M0 -3 C-1.5 -16 -1.5 -30 0 -42', 0.5)}
    ${line('M-2 0 C-6 3 -8 7 -7 11 M2 0 C6 3 8 7 7 11', 0.8, '#b79a7a')}
  </g>`;

// 向日葵：两层舌状花 + 螺旋排列的种子
const sunflower = (cx: number, cy: number, s: number, tilt: number) => {
  let rays = '';
  for (let layer = 0; layer < 2; layer++) {
    const n = 22;
    for (let i = 0; i < n; i++) {
      const a = (360 / n) * (i + layer * 0.5);
      const L = (layer ? 22 : 27) * (0.9 + rand() * 0.15);
      rays += `<g transform="rotate(${a.toFixed(1)})">${shape(
        `M0 -15 C-5 ${-15 - L * 0.35} -3.6 ${-15 - L * 0.85} 0 ${-15 - L} C3.6 ${-15 - L * 0.85} 5 ${-15 - L * 0.35} 0 -15Z`,
        '#e9c46a',
        layer ? 0.55 : 0.75,
        '#e9c46a',
      )}</g>`;
    }
  }
  let seeds = '';
  for (let i = 1; i < 90; i++) {
    const rr = 1.55 * Math.sqrt(i);
    const a = i * 2.39996;
    seeds += dot(Math.cos(a) * rr, Math.sin(a) * rr, 0.65, '#e9c46a', 0.55);
  }
  return `<g transform="translate(${cx} ${cy}) scale(${s} ${s * tilt})">${rays}<circle r="16" fill="#4e3520" class="dot" style="--o:.95;${delay()}"/>${seeds}</g>`;
};

// 薰衣草穗：沿茎轮生的小花
const lavender = (x0: number, y0: number, x1: number, y1: number, cx: number, cy: number) => {
  let out = line(`M${x0} ${y0} Q${cx} ${cy} ${x1} ${y1}`, 0.9, LEAF);
  const at = (t: number) => {
    const x = (1 - t) ** 2 * x0 + 2 * (1 - t) * t * cx + t ** 2 * x1;
    const y = (1 - t) ** 2 * y0 + 2 * (1 - t) * t * cy + t ** 2 * y1;
    const dx = 2 * (1 - t) * (cx - x0) + 2 * t * (x1 - cx);
    const dy = 2 * (1 - t) * (cy - y0) + 2 * t * (y1 - cy);
    return { x, y, ang: (Math.atan2(dy, dx) * 180) / Math.PI + 90 };
  };
  for (let k = 0; k < 11; k++) {
    const t = 0.58 + k * 0.04;
    const { x, y, ang } = at(t);
    const sc = 1 - k * 0.05;
    out += `<g transform="translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${ang.toFixed(1)}) scale(${sc.toFixed(2)})">
      ${shape('M0 0 C-5 -1 -6 -5 -3.5 -7 C-1.5 -5 -0.5 -2 0 0Z', '#9d86c6', 0.75, '#c9b8e6')}
      ${shape('M0 0 C5 -1 6 -5 3.5 -7 C1.5 -5 0.5 -2 0 0Z', '#9d86c6', 0.75, '#c9b8e6')}
    </g>`;
  }
  return out;
};

// 梅花：五瓣 + 花蕊
const plum = (x: number, y: number, s: number) => {
  let out = '';
  for (let i = 0; i < 5; i++) {
    const a = ((Math.PI * 2) / 5) * i - Math.PI / 2 + rand() * 0.2;
    out += shape(
      `M0 0 C${(Math.cos(a - 0.6) * 9).toFixed(1)} ${(Math.sin(a - 0.6) * 9).toFixed(1)} ${(Math.cos(a) * 12).toFixed(1)} ${(Math.sin(a) * 12).toFixed(1)} ${(Math.cos(a) * 11).toFixed(1)} ${(Math.sin(a) * 11).toFixed(1)} C${(Math.cos(a + 0.2) * 12).toFixed(1)} ${(Math.sin(a + 0.2) * 12).toFixed(1)} ${(Math.cos(a + 0.6) * 9).toFixed(1)} ${(Math.sin(a + 0.6) * 9).toFixed(1)} 0 0Z`,
      '#f2b8c6',
      0.5,
      '#f6d7df',
    );
  }
  let stamens = '';
  for (let i = 0; i < 12; i++) {
    const a = (Math.PI * 2 * i) / 12;
    const L = 4.5 + rand() * 2.5;
    stamens += `M0 0 L${(Math.cos(a) * L).toFixed(1)} ${(Math.sin(a) * L).toFixed(1)} `;
    out += dot(Math.cos(a) * L, Math.sin(a) * L, 0.7, '#f6d06b', 0.9);
  }
  return `<g transform="translate(${x} ${y}) scale(${s})">${out}${line(stamens, 0.4, '#f6d06b')}</g>`;
};

const plants: Record<Props['kind'], () => string> = {
  me: () =>
    line('M168 320 C166 282 172 242 164 202 C158 170 162 132 156 100', 1.1, LEAF) +
    line('M166 252 C150 238 136 222 128 198', 0.9, LEAF) +
    line('M165 212 C176 198 184 186 186 172', 0.8, LEAF) +
    line('M150 320 C148 302 140 288 130 278 M184 320 C186 302 192 290 197 282', 0.7, LEAF) +
    leaf(167, 302, -42, 34, 8) +
    leaf(167, 276, 38, 28, 7) +
    leaf(163, 232, -58, 22, 6) +
    tendril(190, 150, 7, 1.6) +
    shape('M186 172 C180 164 182 154 186 150 C190 154 192 164 186 172Z', '#f4f1e6', 0.4) +
    daisy(156, 92, 21, 0.78, -8) +
    daisy(127, 190, 15, 0.62, 18),
  cidi: () =>
    line('M176 320 C172 290 168 262 158 236 C150 214 152 188 146 160 C142 140 146 118 141 100', 1.8, '#9c8670') +
    line('M156 228 C170 214 182 206 189 198', 1.2, '#9c8670') +
    line('M148 182 C134 170 124 158 119 142', 1.2, '#9c8670') +
    line('M172 292 L180 288 M160 244 L152 240', 0.8, '#9c8670') +
    tendril(193, 262, 8, 1.5) +
    line('M193 320 C192 300 194 282 190 262', 0.7, LEAF) +
    leaf(192, 300, 28, 20, 5) +
    shape('M166 262 C161 256 161 247 166 241 C171 247 171 256 166 262Z', '#c9b8a6', 0.45, '#c9b8a6') +
    magnolia(141, 100, -6, 1) +
    magnolia(189, 198, 32, 0.72) +
    magnolia(119, 142, -32, 0.8),
  venture: () =>
    line('M164 320 C162 280 156 232 150 192 C146 168 143 152 139 136', 1.7, LEAF) +
    line('M158 262 C174 246 182 232 185 218', 1, LEAF) +
    leaf(160, 252, -62, 46, 19) +
    leaf(155, 210, 54, 40, 17) +
    leaf(163, 296, 30, 26, 10) +
    tendril(192, 286, 7, 1.7) +
    sunflower(185, 210, 0.42, 0.55) +
    sunflower(137, 96, 1, 0.86),
  analysis: () =>
    lavender(150, 300, 112, 72, 140, 190) +
    lavender(150, 300, 132, 56, 148, 180) +
    lavender(150, 300, 154, 50, 152, 170) +
    lavender(150, 300, 172, 62, 156, 180) +
    lavender(150, 300, 190, 82, 162, 190) +
    leaf(150, 300, -24, 42, 3.5) +
    leaf(150, 300, 22, 38, 3.5) +
    line('M138 268 C146 274 156 274 164 268', 1, '#dce9ee') +
    line('M150 271 C140 282 128 286 124 278 C130 272 140 270 150 271 C160 270 170 272 176 278 C172 286 160 282 150 271', 1, '#dce9ee') +
    line('M150 273 C146 290 140 300 133 308 M150 273 C156 290 161 300 168 308', 0.9, '#dce9ee') +
    tendril(194, 240, 7, 1.5),
  intern: () =>
    line('M60 320 L84 282 L80 252 L104 214 L128 166 L124 130 L140 96', 2.1, '#8b6f5c') +
    line('M104 214 L142 196 L166 168', 1.5, '#8b6f5c') +
    line('M128 166 L156 150', 1.2, '#8b6f5c') +
    line('M84 282 L118 270', 1.2, '#8b6f5c') +
    line('M140 96 L162 72', 1.2, '#8b6f5c') +
    tendril(192, 230, 8, 1.6) +
    line('M192 320 C191 290 194 262 192 230', 0.7, LEAF) +
    dot(142, 196, 2.8, '#e58fa5', 0.8) +
    dot(80, 252, 2.4, '#e58fa5', 0.8) +
    dot(156, 150, 2.6, '#e58fa5', 0.8) +
    plum(118, 270, 0.85) +
    plum(106, 212, 0.7) +
    plum(166, 168, 1) +
    plum(140, 96, 1) +
    plum(162, 72, 0.8),
};

const svg = plants[kind]();
---

<svg
  class:list={['botanical pointer-events-none', className]}
  style={style}
  viewBox="0 0 200 320"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={svg}
/>
