---
// 卡片点开后的内容：左侧（视频）和右侧（说明）各一个模板，点开时由页面脚本放进去
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import Text from '../Text.astro';
import Story from './Story.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry('details', id);
const d = entry?.data;
const poster = d?.poster && (await getImage({ src: d.poster, format: 'webp', width: 1280 }));
// 浅棕色块，从上往下依次加深
const tones = ['#ece2d4', '#e7dac9', '#e2d2be', '#ddcab3', '#d8c2a9', '#d3baa0'];
// 站内文件（如 /files/xx.pdf）还没放进 public/ 时，显示"报告整理中"
// 大数字里的中文单位（如"个百分点"）缩小显示，文字不变
const splitFigure = (f: string) => f.split(/([\u4e00-\u9fa5]+)/).filter(Boolean).map((part) => ({ part, unit: /[\u4e00-\u9fa5]/.test(part) }));
// 图片的大图地址（照片墙点开放大用）
const zoomSrc = async (img: ImageMetadata) => (await getImage({ src: img, format: 'webp', width: 1800 })).src;
const zoom = new Map<ImageMetadata, string>();
for (const t of d?.tabs ?? []) {
  for (const g of t.gallery?.items ?? []) if (g.image) zoom.set(g.image, await zoomSrc(g.image));
  for (const g of t.shots) zoom.set(g.image, await zoomSrc(g.image));
  for (const sec of t.sections) if (sec.photo) zoom.set(sec.photo, await zoomSrc(sec.photo));
}
// 数字条里的数字放大显示
const splitNums = (txt: string) => txt.split(/([\d,.]+\+?%?)/).filter(Boolean).map((part) => ({ part, num: /^[\d,.]+\+?%?$/.test(part) }));
const missing = (href: string) => href.startsWith('/files/') && !existsSync(`public${href}`);
---

{
  d && !d.tabs.length && (
    <>
      <template data-face-for={id} data-ratio={d.videoRatio}>
        <div class="face-media">
          <div class="relative grid h-full w-full place-items-center overflow-hidden rounded-[4px] bg-black">
            {d.video ? (
              <>
                <video data-lazy-video={d.video} muted playsinline preload="none" poster={poster?.src} class="cidi-video h-full w-full object-cover" />
                <button type="button" data-play class="absolute inset-0 grid cursor-pointer place-items-center" aria-label="播放演示视频">
                  <span class="grid h-16 w-16 place-items-center rounded-full bg-white/90 pl-1 text-2xl text-black">▶</span>
                </button>
              </>
            ) : (
              <>
                {poster && <img src={poster.src} alt={d.posterAlt} class="h-full w-full object-contain" />}
                <p class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent pt-16 pb-5 text-center text-sm tracking-[0.2em] text-white/90">演示视频制作中</p>
              </>
            )}
          </div>
        </div>
      </template>

      <template data-side-for={id}>
        <div class="side cidi-grid">
        <div class="cidi-side">
          {d.demo && (
            <div class="pb-8">
              <a href={d.demo.href} target="_blank" rel="noopener" class="demo-link">
                {d.demo.label} <span aria-hidden="true">↗</span>
              </a>
              {d.demo.note && <p class="mt-2 text-xs opacity-60">{d.demo.note}</p>}
            </div>
          )}

          <div class="folds">
          {d.intro && (
            <section class="fold is-open" data-shot-key="intro" style={`--tone: ${tones[0]}`}>
              <button type="button" class="fold-head" aria-expanded="true">
                <span>{d.intro.title}</span>
                <span class="fold-mark" aria-hidden="true" />
              </button>
              <div class="fold-body">
                <div class="min-h-0">
                  <div class="intro px-6 pt-2 pb-8 sm:px-8">
                    {d.intro.body
                      .trim()
                      .split(/\n\s*\n/)
                      .map((para) => (
                        <p>
                          {para.split('\n').map((line, i, all) => (
                            <>
                              {line}
                              {i < all.length - 1 && <br />}
                            </>
                          ))}
                        </p>
                      ))}
                  </div>
                </div>
              </div>
            </section>
          )}

          {d.highlights.map((h, k) => (
            <section class="fold" data-shot-key={k} style={`--tone: ${tones[(k + 1) % tones.length]}`}>
              <button type="button" class="fold-head" aria-expanded="false">
                <span>
                  <span class="mr-3 tabular-nums opacity-50">{String(k + 1).padStart(2, '0')}</span>
                  {h.title}
                </span>
                <span class="fold-mark" aria-hidden="true" />
              </button>
              <div class="fold-body">
                <div class="min-h-0">
                  <div class="hl-body bg-linen/70 mx-3 mb-3 rounded-[4px] p-5 text-[15px] leading-relaxed sm:p-6">
                    <div class="space-y-5">
                    <div>
                      <p class="sub">功能描述</p>
                      <p>{h.desc}</p>
                    </div>
                    <div>
                      <p class="sub">构筑路径</p>
                      <p>{h.path}</p>
                    </div>
                    {h.future && (
                      <div>
                        <p class="sub">未来优化方向</p>
                        <p>{h.future}</p>
                      </div>
                    )}
                    </div>
                    {h.images.length > 0 ? (
                      <div class="gal hl-gal" data-gal>
                        <div class="gal-track" data-gal-track>
                          {h.images.map((img, n) => (
                            <Image src={img} alt={`${h.title}（${n + 1}）`} widths={[400, 800]} sizes="(min-width: 768px) 300px, 90vw" class="gal-img" />
                          ))}
                        </div>
                        {h.images.length > 1 && (
                          <div class="gal-nav">
                            <button type="button" data-gal-step="-1" aria-label="上一张">←</button>
                            <span data-gal-count>1 / {h.images.length}</span>
                            <button type="button" data-gal-step="1" aria-label="下一张">→</button>
                          </div>
                        )}
                      </div>
                    ) : h.video ? (
                      <video src={h.video} muted autoplay loop playsinline preload="none" class="w-full rounded-[4px]" />
                    ) : h.image ? (
                      <Image src={h.image} alt={h.title} widths={[480, 960]} sizes="(min-width: 768px) 560px, 100vw" class="w-full rounded-[4px]" />
                    ) : (
                      <div class="todo-box">
                        图片占位
                        <br />
                        {h.file}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </section>
          ))}
          </div>
          {/* 电脑：展开一个亮点后，底部的小标签用来切换和收起 */}
          <nav class="fold-tabs" aria-label="切换亮点">
            {d.intro && <button type="button" data-fold-go="intro">{d.intro.title}</button>}
            {d.highlights.map((_, k) => (
              <button type="button" data-fold-go={k}>{String(k + 1).padStart(2, '0')}</button>
            ))}
            <button type="button" data-fold-go="none" class="fold-tabs-close">收起</button>
          </nav>
        </div>

        {/* 电脑右栏：当前亮点对应的截图 */}
        <aside class="shot-col" aria-live="polite">
          <div class="shot-pane is-on" data-shot="intro">
            <p class="shot-hint">点击左侧亮点查看对应界面</p>
            <div class="shot-frame">
              {d.poster && <Image src={d.poster} alt={d.posterAlt} widths={[400, 800]} sizes="320px" class="shot-img" />}
            </div>
          </div>
          {d.highlights.map((h, k) => (
            <div class="shot-pane" data-shot={k}>
              <p class="shot-title">
                <span class="mr-2 tabular-nums">{String(k + 1).padStart(2, '0')}</span>
                {h.title}
              </p>
              <div class="gal shot-gal" data-gal>
                <div class="gal-track shot-track" data-gal-track>
                  {h.images.map((img, n) => (
                    <div class="shot-frame">
                      <Image src={img} alt={`${h.title}（${n + 1}）`} widths={[400, 800]} sizes="320px" class="shot-img" />
                    </div>
                  ))}
                </div>
                {h.images.length > 1 && (
                  <div class="gal-nav">
                    <button type="button" data-gal-step="-1" aria-label="上一张">←</button>
                    <span data-gal-count>1 / {h.images.length}</span>
                    <button type="button" data-gal-step="1" aria-label="下一张">→</button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </aside>
        </div>
      </template>
    </>
  )
}

{
  d && d.tabs.length > 0 && (
    <>
      <!-- 左侧：竖排小卡片（手机横排），点击切换右侧项目 -->
      <template data-face-for={id} data-tabs>
        <div class="face-media">
          <div class:list={['tab-list', id === 'venture' && 'is-tint']} role="tablist">
            {d.tabs.map((t, k) => (
              <button type="button" role="tab" data-tab-btn={k} aria-selected={k === d.defaultTab ? 'true' : 'false'} class:list={['tab', k === d.defaultTab && 'is-on']}>
                {t.cover && (
                  <span class:list={['tab-cover', `fit-${t.coverFit}`]} aria-hidden="true">
                    <Image src={t.cover} alt="" widths={[400, 800]} sizes="(min-width: 768px) 420px, 30vw" />
                  </span>
                )}
                <span class="tab-no text-[11px] tabular-nums opacity-60">{String(k + 1).padStart(2, '0')}</span>
                <span class="tab-name">
                  {t.short}
                  {(t.keywords ?? t.tags) && <span class="tab-tags">{t.keywords ?? t.tags}</span>}
                </span>
              </button>
            ))}
          </div>
        </div>
      </template>

      <template data-side-for={id}>
        <div class="side pb-12">
          {d.tabs.map((t, k) => (
            <article data-tab-panel={k} hidden={k !== d.defaultTab} class="tab-panel">
              <header>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <h2 class="text-2xl font-semibold sm:text-3xl">
                  {t.title}
                  {t.subtitle && <span class="font-normal opacity-60">｜{t.subtitle}</span>}
                  {t.logo && <Image src={t.logo} alt="" widths={[160, 320]} sizes="120px" class="title-logo" />}
                </h2>
                {t.links.length > 0 && (
                  <div class="flex shrink-0 flex-wrap gap-2 sm:pt-1">
                    {t.links.map((l) =>
                      missing(l.href) ? (
                        <span class="link-pill is-pending">{l.label.replace(/（PDF）/, '')} · 报告整理中</span>
                      ) : (
                        <a href={l.href} target="_blank" rel="noopener" class="link-pill">
                          {l.label} ↗
                        </a>
                      ),
                    )}
                  </div>
                )}
                </div>
                {(t.period || t.tags) && <p class="mt-2 text-xs tracking-[0.15em] opacity-60">{[t.period, t.tags].filter(Boolean).join('｜')}</p>}
                {t.lede && <p class="text-ink-soft mt-5 text-[15px] leading-[1.9]">{t.lede}</p>}
              </header>

              {t.hero && <Image src={t.hero} alt={t.heroAlt} widths={[800, 1400, 2000]} sizes="(min-width: 768px) 70vw, 100vw" class="mt-6 w-full rounded-[4px]" />}

              {t.bullets.length > 0 && (
                <ul class="mt-8">
                  {t.bullets.map((b) => (
                    <li class="bullet text-ink-soft text-[15px] leading-[1.9]">{b}</li>
                  ))}
                </ul>
              )}

              {t.twoCol ? (
                <div class="two-col mt-8">
                  <div class="col">
                    {t.sections.slice(0, 1).map((sec) => <Story sec={sec} j={0} ink />)}
                  </div>
                  <div class="col space-y-10">
                    {t.sections.slice(1).map((sec, j) => <Story sec={sec} j={j + 1} ink />)}
                    {t.stats && (
                    <section class:list={[t.twoCol ? 'mt-10' : 'mt-10']}>
                      {t.stats.title && <p class="story-sub mb-4">{t.stats.title}</p>}
                      <ul class:list={['stat-strip', t.stats.stack && 'is-stack']}>
                        {t.stats.items.map((it, i) => (
                          <li>
                            {splitNums(it).map(({ part, num }) => (num ? <span class="stat-num">{part}</span> : part))}
                            {i < t.stats!.items.length - 1 && t.stats!.sep && <span class="sr-only">{t.stats!.sep}</span>}
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}
                  </div>
                </div>
              ) : (
                <>
                  {t.stats && !t.stats.after && (
                    <section class:list={[t.twoCol ? 'mt-10' : 'mt-10']}>
                      {t.stats.title && <p class="story-sub mb-4">{t.stats.title}</p>}
                      <ul class:list={['stat-strip', t.stats.stack && 'is-stack']}>
                        {t.stats.items.map((it, i) => (
                          <li>
                            {splitNums(it).map(({ part, num }) => (num ? <span class="stat-num">{part}</span> : part))}
                            {i < t.stats!.items.length - 1 && t.stats!.sep && <span class="sr-only">{t.stats!.sep}</span>}
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}
                  {t.sections.map((sec, j) => (
                    <div class:list={[t.photosBelow ? 'mt-10' : 'mt-12']}>
                      <Story sec={t.photosBelow ? { ...sec, photo: undefined, photoFile: undefined } : sec} j={j} />
                    </div>
                  ))}
                  {t.photosBelow && (
                    <div class="photo-row mt-12" data-zoom-group>
                      {t.sections.filter((sec) => sec.photo).map((sec) => (
                        <figure class="photo-row-item">
                          <button type="button" data-zoom={zoom.get(sec.photo!)} data-alt={sec.caption ?? sec.photoAlt} class="block h-full cursor-zoom-in" aria-label={`放大查看：${sec.caption ?? sec.photoAlt}`}>
                            <Image src={sec.photo!} alt={sec.photoAlt} widths={[400, 800]} sizes="300px" class="photo-row-img" />
                          </button>
                          {sec.caption && <figcaption class="mt-2 text-xs opacity-60">{sec.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  )}
                  {t.stats && t.stats.after && (
                    <section class:list={[t.twoCol ? 'mt-10' : 'mt-10']}>
                      {t.stats.title && <p class="story-sub mb-4">{t.stats.title}</p>}
                      <ul class:list={['stat-strip', t.stats.stack && 'is-stack']}>
                        {t.stats.items.map((it, i) => (
                          <li>
                            {splitNums(it).map(({ part, num }) => (num ? <span class="stat-num">{part}</span> : part))}
                            {i < t.stats!.items.length - 1 && t.stats!.sep && <span class="sr-only">{t.stats!.sep}</span>}
                          </li>
                        ))}
                      </ul>
                    </section>
                  )}
                </>
              )}

              {t.findings.length > 0 && <section class="mt-10">
                <p class="sec">关键发现</p>
                <ol class="mt-2">
                  {t.findings.map((f) => (
                    <li class="finding">
                      <p class="big">{splitFigure(f.figure).map(({ part, unit }) => (unit ? <span class="unit">{part}</span> : part))}</p>
                      <p class="mt-3 text-base font-semibold leading-snug sm:text-lg">{f.claim}</p>
                      <p class="text-ink-soft mt-2 text-sm leading-relaxed">{f.detail}</p>
                      {f.image && <Image src={f.image} alt={f.claim} widths={[600, 1100]} sizes="(min-width: 768px) 760px, 100vw" class="mt-5 w-full rounded-[4px]" />}
                    </li>
                  ))}
                </ol>
              </section>}

              {(t.advice || t.adviceGroups) && (
                <section class="mt-10">
                  <p class="sec">我的建议</p>
                  {t.advice && <p class="text-ink-soft mt-4 text-[15px] leading-[1.9]">{t.advice}</p>}
                  {t.adviceList.length > 0 && (
                    <ul class="text-ink-soft mt-2 space-y-1.5 text-[15px] leading-[1.8]">
                      {t.adviceList.map((it) => (
                        <li class="flex gap-2">
                          <span aria-hidden="true">·</span>
                          <span>{it}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                  {t.adviceAfter && <p class="text-ink-soft mt-3 text-[15px] leading-[1.9]">{t.adviceAfter}</p>}
                  {t.adviceGroups?.map((g) => (
                    <div class="mt-6">
                      <p class="font-semibold">{g.name}</p>
                      <ul class="mt-3 space-y-4">
                        {g.items.map((it) => (
                          <li class="advice-item">
                            <p class="text-ink-soft text-[15px] leading-relaxed">{it.text}</p>
                            {it.basis && <p class="mt-1.5 text-xs leading-relaxed opacity-60">{it.basis}</p>}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  {t.adviceNote && <p class="mt-6 text-[11px] leading-relaxed opacity-50">{t.adviceNote}</p>}
                </section>
              )}

              {t.shots.length > 0 && (
                <section class="mt-10">
                  <div class="gal shots" data-gal data-zoom-group>
                    <div class="gal-track shots-track" data-gal-track>
                      {t.shots.map((g) => (
                        <figure class="shot">
                          <button type="button" data-zoom={zoom.get(g.image)} data-alt={g.caption} class="block w-full cursor-zoom-in" aria-label={`放大查看：${g.caption}`}>
                            <Image src={g.image} alt={g.caption} widths={[480, 960]} sizes="(min-width: 768px) 260px, 90vw" class="w-full rounded-[4px] border border-black/5" />
                          </button>
                          <figcaption class="mt-2 text-xs opacity-60">{g.caption}</figcaption>
                        </figure>
                      ))}
                    </div>
                    <div class="gal-nav shots-nav">
                      <button type="button" data-gal-step="-1" aria-label="上一张">←</button>
                      <span data-gal-count>1 / {t.shots.length}</span>
                      <button type="button" data-gal-step="1" aria-label="下一张">→</button>
                    </div>
                  </div>
                </section>
              )}

              {t.ai && (
                <section class="mt-10">
                  <p class="sec">AI 协作</p>
                  <p class="text-ink-soft mt-4 text-[15px] leading-[1.9]">
                    <Text text={t.ai} />
                  </p>
                </section>
              )}

              {t.gallery && (
                <section class="mt-12">
                  <p class="story-sub">{t.gallery.title}</p>
                  <div class="wall mt-5" data-zoom-group>
                    {t.gallery.items.map((g) =>
                      g.image ? (
                        <button type="button" data-zoom={zoom.get(g.image)} data-alt={g.alt} class="wall-item cursor-zoom-in" aria-label={`放大查看：${g.alt}`}>
                          <Image src={g.image} alt={g.alt} widths={[600, 1100]} sizes="(min-width: 768px) 600px, 90vw" class="h-full w-auto rounded-[4px]" />
                        </button>
                      ) : (
                        <div class="wall-item todo-box wall-todo">
                          照片占位
                          <br />
                          {g.file}
                        </div>
                      ),
                    )}
                  </div>
                </section>
              )}

            </article>
          ))}
        </div>
      </template>
    </>
  )
}

<style>
  @reference '../../styles/global.css';

  .face-media {
    position: absolute;
    inset: 0;
    padding: 0.75rem;
  }
  .side {
    color: var(--accent);
  }
  .demo-btn {
    @apply inline-block rounded-full px-6 py-3 text-sm font-medium transition-transform hover:-translate-y-0.5;
    background: var(--accent);
    color: #f3f1ec;
  }
  .fold {
    background: var(--tone);
    border-radius: 4px;
  }
  .fold-head {
    @apply flex w-full cursor-pointer items-center justify-between gap-4 px-6 py-5 text-left text-base font-medium sm:px-8 sm:text-lg;
  }
  .fold-mark {
    position: relative;
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }
  .fold-mark::before,
  .fold-mark::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s ease;
  }
  .fold-mark::after {
    transform: rotate(90deg);
  }
  .fold.is-open .fold-mark::after {
    transform: rotate(0deg);
  }
  /* 展开 / 收起：高度平滑过渡 */
  .fold-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .fold-body > div {
    overflow: hidden;
  }
  .fold.is-open .fold-body {
    grid-template-rows: 1fr;
  }
  .intro {
    font-size: 15px;
    line-height: 2.1;
    letter-spacing: 0.02em;
  }
  .intro p + p {
    margin-top: 2.2em;
  }
  .sub {
    @apply mb-1 text-xs tracking-[0.2em] opacity-60;
  }
  .todo-box {
    @apply rounded-[4px] border-2 border-dashed p-8 text-center text-sm leading-relaxed;
    border-color: #e0a400;
    background: #fff6d6;
    color: #7a5a00;
  }
  /* ── 左侧小卡片切换 ── */
  .tab-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }
  .tab {
    @apply flex flex-1 cursor-pointer flex-col justify-between rounded-[4px] p-5 text-left transition-colors duration-300;
    background: #f3f1ec;
    color: var(--accent);
  }
  .tab:hover {
    background: #fff;
  }
  .tab.is-on {
    background: color-mix(in oklab, var(--accent) 88%, #fff);
    color: #f3f1ec;
  }
  .tab-name {
    @apply text-lg leading-snug font-medium;
  }
  @media (max-width: 767px) {
    .tab-list {
      flex-direction: row;
    }
    .tab {
      @apply justify-center p-2.5;
    }
    .tab-no {
      display: none;
    }
    .tab-name {
      @apply text-[12px] leading-snug;
    }
  }
  .tab-panel {
    animation: panel-in 0.5s ease both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .text-ink-soft {
    color: color-mix(in oklab, var(--accent) 55%, #2b2823);
  }
  .sec {
    @apply text-xs font-medium tracking-[0.3em];
  }
  .finding {
    padding: 1.75rem 0;
