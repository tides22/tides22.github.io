---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import LinkList from '../LinkList.astro';
import Text from '../Text.astro';

interface Props {
  heading: { kicker: string; title: string; intro?: string };
  jobs: CollectionEntry<'experience'>[];
  youth: CollectionEntry<'youth'>['data'];
}

const { heading, jobs, youth } = Astro.props;
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading {...heading} />

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12">
    <!-- 实习：时间线 -->
    <div class="min-w-0">
      <h3 class="reveal text-muted mb-5 text-sm font-semibold tracking-widest">实习</h3>
      <ol class="border-line relative ml-1.5 space-y-8 border-l-2 border-dashed pl-6">
        {
          jobs.map(({ data }, i) => (
            <li class="reveal relative" style={`--delay: ${i * 0.08}s`}>
              <span class="bg-paper border-sea absolute top-1.5 -left-[33px] h-4 w-4 rounded-full border-[3px]" />
              <p class="text-muted flex flex-wrap items-center gap-2 text-sm">
                {data.period}
                {data.mode && (
                  <span class="bg-sea-soft text-sea-deep rounded-full px-2 py-0.5 text-xs font-medium">
                    {data.mode}
                  </span>
                )}
              </p>
              <h4 class="mt-1 text-lg font-bold">{data.company}</h4>
              <p class="text-muted text-[15px]">{data.role}</p>
              <ul class="mt-2.5 space-y-1.5 text-[15px] leading-relaxed">
                {data.bullets.map((item) => (
                  <li class="before:bg-leaf relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full">
                    {item}
                  </li>
                ))}
              </ul>
              <LinkList links={data.links} class="mt-3" />
            </li>
          ))
        }
      </ol>
    </div>

    <!-- 友思 -->
    <div class="reveal bg-sea-soft/60 min-w-0 rounded-[2rem] p-5 sm:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="text-lg font-bold">{youth.org}</h3>
        <p class="text-muted text-sm">{youth.period}</p>
      </div>
      {
        youth.badge && (
          <p class="bg-sun-soft mt-2 inline-block rounded-full px-3 py-0.5 text-xs font-medium">{youth.badge}</p>
        )
      }

      <!-- 我负责的项目 -->
      <article class="mt-5 overflow-hidden rounded-3xl bg-white">
        <Image
          src={youth.lead.photo}
          alt={youth.lead.photoAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 520px, 100vw"
          class="aspect-[16/9] w-full object-cover"
        />
        <div class="p-5">
          <p class="text-leaf-deep text-xs font-semibold tracking-widest">我负责的项目</p>
          <h4 class="mt-1 text-xl font-bold">{youth.lead.title}</h4>
          <p class="text-muted text-[15px]">{youth.lead.role}</p>
          <p class="font-hand border-leaf mt-4 border-l-4 pl-3 text-lg">“{youth.lead.theme}”</p>
          <p class="mt-4">
            <span class="font-display text-leaf-deep text-3xl">{youth.lead.result.value}</span>
            <span class="ml-1 font-medium">{youth.lead.result.label}</span>
          </p>
          <p class="mt-3 text-[15px]"><Text text={youth.lead.story} /></p>
        </div>
      </article>

      <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-[minmax(0,1fr)_auto]">
        <!-- 我参与的项目 -->
        <div class="min-w-0">
          <p class="text-muted mb-2 text-xs font-semibold tracking-widest">我参与的项目</p>
          <LinkList links={youth.joined} />
        </div>

        <!-- 我设计的作品 -->
        <div>
          <p class="text-muted mb-2 text-xs font-semibold tracking-widest">我设计的作品</p>
          {
            youth.designs.map((design) => (
              <a
                href={design.href}
                target="_blank"
                class="group flex items-center gap-3 rounded-2xl bg-white p-2 pr-4 transition-shadow hover:shadow-md"
              >
                <Image
                  src={design.cover}
                  alt={design.coverAlt}
                  widths={[96, 160]}
                  sizes="64px"
                  class="aspect-[1/2] w-12 rounded-lg object-cover object-top"
                />
                <span>
                  <span class="group-hover:text-sea-deep block font-medium transition-colors">{design.title}</span>
                  <span class="text-muted block text-xs">{design.type} · PDF</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- 合照和留言 -->
      <p class="text-muted mt-6 mb-2 text-xs font-semibold tracking-widest">和伙伴们</p>
      <div class="-mx-5 flex snap-x gap-2 overflow-x-auto px-5 pb-2 sm:-mx-7 sm:px-7">
        {
          youth.photos.map((photo) => (
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[240, 480]}
              sizes="200px"
              class="aspect-[4/3] w-44 shrink-0 snap-start rounded-2xl object-cover sm:w-48"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
