---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import Tags from '../Tags.astro';
import LinkList from '../LinkList.astro';

interface Props {
  heading: { kicker: string; title: string; intro?: string };
  projects: CollectionEntry<'projects'>[];
}

const { heading, projects } = Astro.props;
const deep = projects.filter((p) => p.data.kind === 'deep');
const cards = projects.filter((p) => p.data.kind === 'card');
const deepBg = ['bg-leaf-soft', 'bg-sea-soft'];
---

<section id="projects" class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
  <SectionHeading {...heading} />

  <!-- 深度案例 -->
  <div class="space-y-6">
    {
      deep.map(({ id, data }, i) => {
        const isPhone = data.cover.height > data.cover.width;
        return (
          <article
            id={`project-${id}`}
            class="reveal border-line grid overflow-hidden rounded-[2rem] border bg-white md:grid-cols-2"
          >
            <div
              class:list={[
                'relative flex items-end justify-center overflow-hidden',
                deepBg[i % deepBg.length],
                isPhone ? 'h-64 px-10 pt-8 sm:h-80 md:h-auto md:min-h-96' : 'aspect-[4/3] md:aspect-auto',
                i % 2 === 1 && 'md:order-2',
              ]}
            >
              {isPhone ? (
                <Image
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[280, 420, 560]}
                  sizes="(min-width: 768px) 280px, 240px"
                  class="border-ink/80 absolute top-8 w-56 rounded-t-[2rem] border-[6px] border-b-0 shadow-xl sm:w-64"
                />
              ) : (
                <Image
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 768px) 512px, 100vw"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
              <span class="bg-paper/90 absolute top-4 left-4 rounded-full px-3 py-1 text-xs font-semibold">
                深度案例 0{i + 1}
              </span>
            </div>

            <div class="flex flex-col p-6 sm:p-8">
              <p class="text-muted text-sm">
                {data.period} · {data.role}
              </p>
              <h3 class="mt-2 text-2xl font-bold">
                {data.title}
                <span class="text-muted ml-1 text-base font-normal">{data.subtitle}</span>
              </h3>
              <p class="mt-3 leading-relaxed">{data.summary}</p>

              <ul class="mt-5 space-y-2">
                {data.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 text-[15px]">
                    <svg
                      class="text-leaf-deep mt-1 h-4 w-4 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.6"
                      aria-hidden="true"
                    >
                      <path d="m5 12 5 5 9-10" />
                    </svg>
                    <span class="font-medium">{item}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-6">
                <Tags tags={data.tags} />
              </div>

              <div class="mt-auto flex flex-wrap items-center gap-2 pt-6">
                <span class="border-line text-muted rounded-full border border-dashed px-3.5 py-1.5 text-sm">
                  完整案例 · 制作中
                </span>
                <LinkList links={data.links} />
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <!-- 项目卡片：手机上左右滑动，电脑上三列 -->
  <h3 class="reveal text-muted mt-14 mb-4 text-sm font-semibold tracking-widest">数据分析项目</h3>
  <div
    class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-3"
  >
    {
      cards.map(({ id, data }, i) => (
        <article
          id={`project-${id}`}
          class="reveal border-line flex w-[82%] shrink-0 snap-start flex-col overflow-hidden rounded-3xl border bg-white sm:w-auto"
          style={`--delay: ${i * 0.08}s`}
        >
          <Image
            src={data.cover}
            alt={data.coverAlt}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 82vw"
            class="border-line aspect-[16/10] w-full border-b object-cover object-top"
          />
          <div class="flex flex-1 flex-col p-5">
            <p class="text-muted text-xs">{data.period}</p>
            <h4 class="mt-1 text-lg leading-snug font-bold">{data.title}</h4>
            <p class="text-muted text-sm">{data.subtitle}</p>
            <p class="mt-3 text-[15px] leading-relaxed">{data.summary}</p>
            <div class="mt-4">
              <Tags tags={data.tags} />
            </div>
            <LinkList links={data.links} class="mt-auto pt-5" />
          </div>
        </article>
      ))
    }
  </div>
</section>
