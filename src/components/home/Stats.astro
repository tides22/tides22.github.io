---
import type { CollectionEntry } from 'astro:content';

interface Props {
  stats: CollectionEntry<'home'>['data']['stats'];
}

const accents = [
  { text: 'text-leaf-deep', bar: 'bg-leaf' },
  { text: 'text-sea-deep', bar: 'bg-sea' },
  { text: 'text-leaf-deep', bar: 'bg-sun' },
];
---

<section aria-label="亮点数字" class="mx-auto max-w-5xl px-4 sm:px-6">
  <div class="grid gap-3 sm:grid-cols-3 sm:gap-4">
    {
      Astro.props.stats.map((stat, i) => (
        <a
          href={stat.href}
          class="reveal group border-line flex items-center gap-4 rounded-3xl border bg-white/80 p-5 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-sea/10 sm:flex-col sm:items-start sm:gap-2 sm:p-6"
          style={`--delay: ${i * 0.08}s`}
        >
          <p class:list={['font-display shrink-0 text-4xl leading-none sm:text-5xl', accents[i].text]}>
            {stat.value}
            {stat.unit && <span class="text-2xl sm:text-3xl">{stat.unit}</span>}
          </p>
          <div class="min-w-0">
            <span class:list={['mb-2 hidden h-1 w-10 rounded-full sm:block', accents[i].bar]} />
            <p class="leading-snug font-medium">{stat.label}</p>
            <p class="text-muted mt-0.5 text-sm">
              {stat.note}
              <span class="group-hover:text-leaf-deep ml-1 transition-colors" aria-hidden="true">
                →
              </span>
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>
